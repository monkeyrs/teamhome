DATABASE_URL=postgresql+psycopg2://admin:admin@localhost:5432/teamhome
JWT_SECRET=dev-secret-change-me
DB_AUTO_CREATE=false

# Optional: WeChat login exchange
# WECHAT_APPID=
# WECHAT_SECRET=

# Optional: OpenAI-compatible LLM parsing
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-openai-compatible-host/compatible-model/v1
# OPENAI_MODEL=your-model-id
# OPENAI_SSL_VERIFY=true
# OPENAI_AUTO_SWITCH_MODELS=true
# OPENAI_MODEL_MAX_ATTEMPTS=6
# OPENAI_MODEL_FALLBACKS=modelA,modelB,modelC

# Assistant engine selector: legacy or langgraph
# ASSISTANT_ENGINE=legacy

# Optional: Official LangGraph debugging chain via LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=teamhome-assistant
# LANGSMITH_WORKSPACE_ID=
