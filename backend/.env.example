DATABASE_URL=postgresql+psycopg2://teamhome_user:change-this-db-password@localhost:5432/teamhome
POSTGRES_DB=teamhome
POSTGRES_USER=teamhome_user
POSTGRES_PASSWORD=change-this-db-password
ENVIRONMENT=development
JWT_SECRET=change-this-jwt-secret-to-32-plus-chars
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
ALLOW_INSECURE_DEV_AUTH=true
ENABLE_DEBUG_ENDPOINTS=true
MAX_UPLOAD_BYTES=5242880

# Database schema is managed by Alembic migrations.

# Optional: WeChat login exchange
# WECHAT_APPID=
# WECHAT_SECRET=

# Optional: OpenAI-compatible LLM parsing
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-openai-compatible-host/compatible-model/v1
# OPENAI_MODEL=your-model-id
# OPENAI_SSL_VERIFY=true
# OPENAI_AUTO_SWITCH_MODELS=true
# OPENAI_MODEL_MAX_ATTEMPTS=6
# OPENAI_MODEL_FALLBACKS=modelA,modelB,modelC

# Assistant engine selector: legacy or langgraph
# ASSISTANT_ENGINE=legacy

# Optional: Official LangGraph debugging chain via LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=teamhome-assistant
# LANGSMITH_WORKSPACE_ID=
# LANGGRAPH_API_URL=http://127.0.0.1:22024
# LANGGRAPH_ASSISTANT_ID=assistant_orchestrator
# LANGGRAPH_REQUEST_TIMEOUT_SECONDS=45
