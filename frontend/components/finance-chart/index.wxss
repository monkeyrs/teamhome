.header {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #353535;
}

.line {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.label {
  width: 140rpx;
  font-size: 24rpx;
  color: #888888;
}

.bar-wrap {
  flex: 1;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ededed;
  overflow: hidden;
}

.bar {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #06ad56);
}

.amount {
  width: 130rpx;
  text-align: right;
  font-size: 24rpx;
  margin-left: 12rpx;
  color: #353535;
}
