.chart-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.line {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.line-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.label {
  font-size: 26rpx;
  color: var(--text-regular);
}

.bar-wrap {
  width: 100%;
  height: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-muted);
  overflow: hidden;
}

.bar {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, #12b85f 0%, #07c160 100%);
}

.amount {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.empty-chart {
  font-size: 24rpx;
}
