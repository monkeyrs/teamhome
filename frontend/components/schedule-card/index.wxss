.schedule-card {
  border-left: 8rpx solid #07c160;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: #353535;
}

.row {
  font-size: 24rpx;
  margin: 4rpx 0;
  color: #888888;
}

.status {
  margin-top: 14rpx;
  font-size: 22rpx;
  display: inline-block;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  background: #f2f2f2;
  color: #666666;
}

.status-completed {
  background: #e8f7ef;
  color: #07c160;
}

.status-cancelled {
  background: #feeeee;
  color: #fa5151;
}
