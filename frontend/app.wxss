page {
  background: #f7f7f7;
  color: #353535;
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  margin-top: 12rpx;
}

.muted {
  color: #888888;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #353535;
  margin-bottom: 14rpx;
}

.picker,
.input-control,
.textarea-control {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  background: #ffffff;
  color: #353535;
}

.picker,
.input-control {
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.textarea-control {
  min-height: 180rpx;
  width: 100%;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.list-title {
  font-size: 34rpx;
  font-weight: 600;
  margin: 26rpx 24rpx 8rpx;
  color: #353535;
}
