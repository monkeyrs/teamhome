.graph-idle-ambient {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 4;
}

.graph-idle-orb {
  pointer-events: auto;
  position: absolute;
  top: 30%;
  left: 24%;
  width: 22rpx;
  height: 22rpx;
  margin-top: -11rpx;
  margin-left: -11rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.98) 0%, rgba(125, 211, 252, 0.92) 38%, rgba(96, 165, 250, 0.24) 78%, rgba(96, 165, 250, 0) 100%);
  box-shadow: 0 0 22rpx rgba(147, 197, 253, 0.88), 0 0 58rpx rgba(125, 211, 252, 0.5);
  opacity: 0.94;
  animation: graph-idle-orb-path 28s cubic-bezier(0.45, 0.05, 0.32, 0.99) infinite;
}

.graph-idle-halo {
  pointer-events: none;
  position: absolute;
  top: 30%;
  left: 24%;
  width: 260rpx;
  height: 260rpx;
  margin-top: -130rpx;
  margin-left: -130rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(191, 219, 254, 0.26) 0%, rgba(186, 230, 253, 0.1) 42%, rgba(255, 255, 255, 0) 76%);
  filter: blur(10rpx);
  opacity: 0.9;
  animation: graph-idle-halo-path 28s ease-in-out infinite;
}

.graph-idle-halo-soft {
  animation-delay: -2s;
}

.graph-pulse-burst {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 5;
}

.graph-pulse-core,
.graph-pulse-wave {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.graph-pulse-core {
  width: 34rpx;
  height: 34rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.98) 0%, rgba(191, 219, 254, 0.94) 34%, rgba(96, 165, 250, 0.24) 78%, rgba(96, 165, 250, 0) 100%);
  box-shadow: 0 0 24rpx rgba(147, 197, 253, 0.88), 0 0 72rpx rgba(125, 211, 252, 0.52);
  animation: graph-pulse-core-pop 920ms ease-out forwards;
}

.graph-pulse-wave {
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(191, 219, 254, 0.22) 0%, rgba(147, 197, 253, 0.16) 34%, rgba(191, 219, 254, 0) 72%);
