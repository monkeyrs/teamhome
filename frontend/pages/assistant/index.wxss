.answer-data {
  margin-top: 16rpx;
  word-break: break-all;
  font-size: 24rpx;
}

.compact-card {
  padding: 18rpx 24rpx;
}

.team-compact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.team-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #353535;
}

.team-arrow {
  font-size: 24rpx;
  color: #888888;
}

.team-panel {
  margin-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.team-create-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.team-input {
  flex: 1;
}

.mini-action {
  min-width: 176rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 26rpx;
  padding: 0 18rpx;
}

.team-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  border-top: 1rpx solid #f5f5f5;
}

.team-option-name {
  flex: 1;
  padding: 16rpx 0;
  color: #353535;
}

.team-remove {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #fff1f0;
  color: #fa5151;
  font-size: 36rpx;
}

.assistant-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.send-btn {
  flex: 1;
  margin-top: 0;
}

.voice-btn {
  width: 116rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f2f2f2;
  color: #353535;
}

.voice-btn-recording {
  background: #07c160;
  color: #ffffff;
}

.btn-secondary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  color: #353535;
  font-size: 30rpx;
  margin-top: 12rpx;
}
