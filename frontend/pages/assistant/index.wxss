    box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.16);
    transform: translateY(0);
  }
  2.6%, 9.4% {
    background: linear-gradient(135deg, var(--graph-idle-start) 0%, var(--graph-idle-end) 100%);
    color: var(--graph-idle-text);
    box-shadow:
      inset 0 0 0 1rpx rgba(255, 255, 255, 0.34),
      0 12rpx 26rpx var(--graph-idle-glow);
    transform: translateY(-4rpx) scale(1.02);
  }
}

