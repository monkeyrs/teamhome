.modal-action {
  margin-top: 20rpx;
}

.assistant-top-card {
  position: relative;
  padding: 16rpx 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 40rpx rgba(35, 49, 42, 0.07);
}

.info-card {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.assistant-hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.assistant-hero-copy {
  min-width: 0;
  flex: 1;
}

.assistant-titleline {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.assistant-title {
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 700;
  color: var(--text-primary);
  flex-shrink: 0;
}

.assistant-copy {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.locale-trigger {
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.locale-menu {
  position: absolute;
  top: 68rpx;
  right: 24rpx;
  width: 220rpx;
  padding: 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.14);
  z-index: 3;
}

.locale-option {
  min-height: 64rpx;
  border-radius: 16rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  color: var(--text-regular);
  font-size: 24rpx;
}

.locale-option-active {
  background: var(--bg-soft);
  color: var(--brand);
  font-weight: 600;
}

.answer-data {
  margin-top: 16rpx;
  word-break: break-all;
  font-size: 24rpx;
}

.assistant-form-card {
  transition: background-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
}

.assistant-form-card-feedback {
  background: linear-gradient(180deg, #f4fff8 0%, #ffffff 100%);
  box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.14), 0 12rpx 28rpx rgba(7, 193, 96, 0.12);
}

.answer-header {
  align-items: center;
}

.answer-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.answer-top-chip {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f0f7ff;
  color: #2b6cb0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  flex: 0 0 auto;
  box-sizing: border-box;
  flex-shrink: 0;
}

.answer-top-chip-secondary {
  background: var(--bg-soft);
  color: var(--text-regular);
}

.answer-top-chip-undo {
  background: #f3f4f6;
  color: #4b5563;
}

.answer-top-chip-confirm {
  background: #dcfce7;
  color: #166534;
}

.answer-top-chip-cancel {
  background: #f3f4f6;
  color: #4b5563;
}

.answer-text {
  font-size: 30rpx;
  color: var(--text-regular);
  line-height: 1.65;
}

.answer-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.input-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.assistant-textarea {
  height: 120rpx;
  background: #eaf3ff;
  border-color: #c9defa;
}

.assistant-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.assistant-textarea-inline {
  flex: 1;
  min-height: 88rpx;
  height: 88rpx;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}

.nickname-overlay-card {
  max-width: 640rpx;
}

.profile-fields {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.profile-save-btn {
  width: 100%;
}

.verify-code-wrap {
  position: relative;
  width: 100%;
}

.verify-code-grid {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.verify-code-cell {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--bg-soft);
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.verify-code-cell-focus {
  border-color: #bfdbfe;
}

.verify-code-hidden-input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
}

.quick-replies {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  align-items: center;
}

.quick-reply-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--text-inverse);
  font-size: 24rpx;
  line-height: 1;
}

.quick-reply-btn-secondary {
  background: var(--bg-soft);
  color: var(--text-regular);
}

.compact-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.team-compact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.team-summary {
  flex: 1;
  min-width: 0;
}

.team-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.team-line {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.team-summary-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.team-switch-btn {
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.team-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line-primary);
}

.team-panel-embedded {
  margin-top: 18rpx;
}

.team-create-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  align-items: center;
}

.team-input {
  flex: 1;
  min-width: 0;
}

.demo-entry-panel {
  margin-bottom: 12rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.demo-entry-title {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.demo-entry-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.demo-entry-option + .demo-entry-option {
  margin-top: 8rpx;
}

.demo-entry-label {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.demo-entry-meta {
  font-size: 20rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.team-join-btn {
  flex: 0 0 20%;
  min-width: 132rpx;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.team-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 0;
  border-top: 1rpx solid var(--line-secondary);
  padding: 12rpx 0;
}

.team-option-main {
  flex: 1;
  min-width: 0;
}

.team-option-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.team-option-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-regular);
}

.team-option-meta {
  font-size: 18rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.team-option-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.team-eye-btn {
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.team-remove {
  min-width: 92rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--bg-warn-soft);
  color: var(--danger);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assistant-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.send-btn {
  flex: 1;
}

.send-btn-inline {
  flex: 0 0 20%;
  min-width: 132rpx;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.send-btn-inline-stop {
  background: #d1d5db;
  color: #374151;
}

.sheet-overlay {
  align-items: flex-end;
}

.bottom-sheet {
  width: 100%;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  background: var(--bg-card);
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.sheet-btn {
  flex: 1;
}

.assistant-graph-card {
  gap: 18rpx;
}

.assistant-graph-header {
  align-items: flex-start;
  justify-content: flex-start;
  flex-direction: column;
  gap: 8rpx;
}

.assistant-graph-title {
  font-size: 34rpx;
  line-height: 1.2;
}

.assistant-graph-meta {
  font-size: 24rpx;
  line-height: 1.45;
}

.graph-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.graph-row-connector {
  min-height: 28rpx;
  align-items: center;
}

.graph-spacer {
  flex: 1;
  min-width: 0;
}

.graph-center {
  width: 56rpx;
  flex: 0 0 56rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.graph-center-arrow {
  gap: 6rpx;
}

.graph-arrow-line {
  flex: 1;
  height: 4rpx;
  border-radius: 999rpx;
  background: #cbd5e1;
}

.graph-arrow-head {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid #94a3b8;
}

.graph-stem {
  width: 4rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #d6e0ee;
}

.graph-center-fork {
  min-height: 108rpx;
}

.graph-fork-horizontal {
  width: 56rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #d6e0ee;
}

.graph-fork-vertical {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 50%;
  width: 4rpx;
  margin-left: -2rpx;
  border-radius: 999rpx;
  background: #d6e0ee;
}

.graph-node {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.graph-node-muted {
  background: linear-gradient(135deg, #e5e7eb 0%, #cbd5e1 100%);
  color: #334155;
}

.graph-node-primary {
  background: linear-gradient(135deg, #163a6b 0%, #24539a 100%);
  color: #ffffff;
}

.graph-node-blue {
  background: linear-gradient(135deg, #2b6cb0 0%, #3f8cff 100%);
  color: #ffffff;
}

.graph-node-green {
  background: linear-gradient(135deg, #138a5d 0%, #20b26c 100%);
  color: #ffffff;
}

.graph-node-orange {
  background: linear-gradient(135deg, #d97706 0%, #f5a623 100%);
  color: #ffffff;
}

.graph-node-violet {
  background: linear-gradient(135deg, #6d4bd1 0%, #8b5cf6 100%);
  color: #ffffff;
}

.graph-node-dark {
  background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
  color: #ffffff;
}

.graph-node-title {
  font-size: 24rpx;
  font-weight: 700;
}

.graph-node-desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.graph-node-muted .graph-node-desc {
  color: rgba(51, 65, 85, 0.82);
}

.graph-foot {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.graph-pill {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef3f8;
  color: #173865;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.graph-foot-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--text-secondary);
}
