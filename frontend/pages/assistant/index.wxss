.modal-action {
  margin-top: 20rpx;
}

.assistant-top-card {
  position: relative;
}

.info-card {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.info-copy {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.locale-trigger {
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.locale-menu {
  position: absolute;
  top: 68rpx;
  right: 24rpx;
  width: 220rpx;
  padding: 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.14);
  z-index: 3;
}

.locale-option {
  min-height: 64rpx;
  border-radius: 16rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  color: var(--text-regular);
  font-size: 24rpx;
}

.locale-option-active {
  background: var(--bg-soft);
  color: var(--brand);
  font-weight: 600;
}

.answer-data {
  margin-top: 16rpx;
  word-break: break-all;
  font-size: 24rpx;
}

.answer-header {
  align-items: center;
}

.answer-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.answer-top-chip {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f0f7ff;
  color: #2b6cb0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  flex: 0 0 auto;
  box-sizing: border-box;
  flex-shrink: 0;
}

.answer-top-chip-secondary {
  background: var(--bg-soft);
  color: var(--text-regular);
}

.answer-top-chip-undo {
  background: #f3f4f6;
  color: #4b5563;
}

.answer-top-chip-confirm {
  background: #dcfce7;
  color: #166534;
}

.answer-top-chip-cancel {
  background: #f3f4f6;
  color: #4b5563;
}

.answer-text {
  font-size: 30rpx;
  color: var(--text-regular);
  line-height: 1.65;
}

.answer-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.input-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.assistant-textarea {
  height: 120rpx;
  background: #eaf3ff;
  border-color: #c9defa;
}

.assistant-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.assistant-textarea-inline {
  flex: 1;
  min-height: 88rpx;
  height: 88rpx;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}

.quick-replies {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  align-items: center;
}

.quick-reply-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--text-inverse);
  font-size: 24rpx;
  line-height: 1;
}

.quick-reply-btn-secondary {
  background: var(--bg-soft);
  color: var(--text-regular);
}

.compact-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.team-compact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.team-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.team-line {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.team-switch-btn {
  min-width: 88rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.team-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line-primary);
}

.team-create-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  align-items: center;
}

.team-input {
  flex: 1;
  min-width: 0;
}

.team-join-btn {
  flex: 0 0 20%;
  min-width: 132rpx;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.team-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  border-top: 1rpx solid var(--line-secondary);
}

.team-option-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-regular);
}

.team-remove {
  min-width: 92rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--bg-warn-soft);
  color: var(--danger);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assistant-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.send-btn {
  flex: 1;
}

.send-btn-inline {
  flex: 0 0 20%;
  min-width: 132rpx;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.send-btn-inline-stop {
  background: #d1d5db;
  color: #374151;
}
