.modal-action {
  margin-top: 20rpx;
}

.answer-data {
  margin-top: 16rpx;
  word-break: break-all;
  font-size: 24rpx;
}

.answer-header {
  align-items: center;
}

.answer-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.answer-text {
  font-size: 30rpx;
  color: var(--text-regular);
  line-height: 1.65;
}

.undo-icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.undo-icon-text {
  font-size: 22rpx;
  line-height: 1;
  color: var(--text-secondary);
  font-weight: 600;
}

.compact-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.team-compact {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.team-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.team-arrow {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.team-panel {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line-primary);
}

.team-create-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.team-input {
  flex: 1;
}

.team-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 96rpx;
  border-top: 1rpx solid var(--line-secondary);
}

.team-option-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-regular);
}

.team-remove {
  min-width: 92rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--bg-warn-soft);
  color: var(--danger);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.assistant-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.send-btn {
  flex: 1;
}

.voice-btn {
  width: 132rpx;
  min-height: 88rpx;
  border-radius: var(--radius-control);
  background: var(--bg-soft);
  color: var(--text-regular);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn-recording {
  background: var(--brand);
  color: var(--text-inverse);
}
