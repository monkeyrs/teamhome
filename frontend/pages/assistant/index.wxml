<view class="card compact-card">
  <view class="team-compact" bindtap="toggleTeamPanel">
    <view class="team-name">{{teams.length ? teams[teamIndex].name : "请选择团队"}}</view>
    <view class="team-arrow">{{teamPanelOpen ? "收起" : "切换"}}</view>
  </view>

  <view wx:if="{{teamPanelOpen}}" class="team-panel">
    <view class="team-create-row">
      <input
        class="input-control team-input"
        maxlength="20"
        placeholder="创建或加入团队"
        value="{{teamName}}"
        bindinput="onTeamNameInput"
      />
      <button class="mini-action" bindtap="createOrJoinTeam">创建/加入</button>
    </view>

    <block wx:for="{{teams}}" wx:key="id">
      <view class="team-option">
        <view class="team-option-name" data-index="{{index}}" bindtap="onSelectTeam">{{item.name}}</view>
        <view class="team-remove" data-team-id="{{item.id}}" data-team-name="{{item.name}}" bindtap="confirmLeaveTeam">-</view>
      </view>
    </block>
  </view>
</view>

<view class="card">
  <view class="section-title">团队助手</view>
  <textarea
    class="textarea-control"
    placeholder="例如：上个月餐饮花了多少"
    value="{{question}}"
    bindinput="onQuestionInput"
  />
  <view class="assistant-actions">
    <button class="btn-primary send-btn" loading="{{loading}}" bindtap="askAssistant">发送</button>
    <view
      class="voice-btn {{recording ? 'voice-btn-recording' : ''}}"
      bindtouchstart="startRecording"
      bindtouchend="stopRecording"
      bindtouchcancel="stopRecording"
    >语音</view>
  </view>
  <button class="btn-secondary" bindtap="undoLastDelete">撤销最近删除</button>
</view>

<view class="card" wx:if="{{answer}}">
  <view class="section-title">回答</view>
  <view>{{answer}}</view>
  <view class="muted answer-data">{{answerDataText}}</view>
</view>
