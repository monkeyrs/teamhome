<view class="page-shell">
  <view class="page-stack">
    <view class="card info-card assistant-top-card">
      <view class="assistant-hero-head">
        <view class="assistant-hero-copy">
          <view class="assistant-titleline">
            <view class="assistant-title">{{i18n.page.heroTitle}}</view>
            <view class="assistant-copy">{{i18n.page.heroDesc}}</view>
          </view>
        </view>
        <view class="locale-trigger" bindtap="toggleLocaleMenu">{{i18n.app.languageButton}}</view>
      </view>
      <view class="locale-menu" wx:if="{{localeMenuOpen}}">
        <block wx:for="{{languageOptions}}" wx:key="code">
          <view class="locale-option {{locale === item.code ? 'locale-option-active' : ''}}" data-locale="{{item.code}}" bindtap="selectLanguage">{{item.label}}</view>
        </block>
      </view>

      <view class="team-compact" bindtap="toggleTeamPanel">
          <view class="team-summary">
            <view class="team-line">
              <text class="team-line-label">{{i18n.page.currentTeam}}</text>
              <text>:</text>
              <text class="team-line-name">{{teams.length ? teams[teamIndex].name : i18n.page.noTeam}}</text>
              <text wx:if="{{teams.length && teams[teamIndex].isDemo}}" class="team-demo-badge">{{i18n.page.teamDemoBadge}}</text>
            </view>
          </view>
        <view class="team-switch-btn">{{teamPanelOpen ? i18n.common.collapse : i18n.common.switch}}</view>
      </view>

      <view wx:if="{{teamPanelOpen}}" class="team-panel team-panel-embedded">
        <view class="team-create-row">
          <input
            class="input-control team-input"
            maxlength="20"
            placeholder="{{i18n.page.teamInputPlaceholder}}"
            value="{{teamName}}"
            bindinput="onTeamNameInput"
            bindfocus="onTeamNameFocus"
            bindblur="onTeamNameBlur"
          />
          <button class="btn-primary team-join-btn" loading="{{teamActionLoading}}" disabled="{{teamActionLoading}}" bindtap="createOrJoinTeam">{{i18n.page.teamActionPrimary}}</button>
        </view>
        <view class="demo-entry-panel" wx:if="{{teamInputFocused && demoEntryOptions.length}}">
        <view class="demo-entry-title">{{i18n.page.demoEntryTitle}}</view>
        <block wx:for="{{demoEntryOptions}}" wx:key="key">
          <view class="demo-entry-option" data-team-name="{{item.teamName}}" bindtap="openDemoTeamFromEntry">
            <view class="demo-entry-label">
              <text class="demo-entry-name">{{item.displayName}}</text>
              <text class="demo-entry-badge">{{i18n.page.teamDemoBadge}}</text>
            </view>
            <view class="demo-entry-meta">{{i18n.page.demoEntryHint}}</view>
          </view>
        </block>
      </view>

        <block wx:for="{{teams}}" wx:key="id">
            <view class="team-option">
              <view class="team-option-main" data-index="{{index}}" bindtap="onSelectTeam">
                <view class="team-option-head">
                  <view class="team-option-name-row">
                    <view class="team-option-name">{{item.name}}</view>
                    <view wx:if="{{item.isDemo}}" class="team-demo-badge">{{i18n.page.teamDemoBadge}}</view>
                    <view wx:if="{{item.metaText && !item.isDemo}}" class="team-option-meta-inline">{{item.metaText}}</view>
                  </view>
                </view>
              </view>
            <view class="team-option-actions">
              <view
                wx:if="{{item.join_password}}"
                class="team-eye-btn"
                data-team-id="{{item.id}}"
                bindtap="toggleTeamPassword"
              >
                {{item.passwordButtonText}}
              </view>
              <view class="team-remove team-switch-btn" data-team-id="{{item.id}}" data-team-name="{{item.name}}" data-is-demo="{{item.isDemo}}" bindtap="confirmLeaveTeam">{{i18n.common.leave}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="page-overlay sheet-overlay" wx:if="{{teamDialogOpen}}" bindtap="closeTeamDialog">
      <view class="bottom-sheet" catchtap="noop">
        <view class="section-title">{{teamDialogMode === 'join' ? i18n.page.teamJoinSheetTitle : i18n.page.teamCreateSheetTitle}}</view>
        <view class="overlay-text">{{teamDialogMode === 'join' ? i18n.page.teamJoinSheetText : i18n.page.teamCreateSheetText}}</view>

        <view class="field-group">
          <view class="field-label">{{i18n.page.teamNameLabel}}</view>
          <view class="info-panel">{{teamDialogName}}</view>
        </view>

        <view class="field-group">
          <view class="field-label">{{i18n.page.teamPassword}}</view>
          <view class="verify-code-wrap" bindtap="focusTeamDialogPasswordInput">
            <view class="verify-code-grid">
              <block wx:for="{{teamDialogPasswordCells}}" wx:key="index">
                <view class="verify-code-cell {{teamDialogPasswordFocus ? 'verify-code-cell-focus' : ''}}">
                  {{item}}
                </view>
              </block>
            </view>
            <input
              class="verify-code-hidden-input"
              type="number"
              maxlength="4"
              placeholder="{{i18n.page.teamPasswordPlaceholder}}"
              placeholder-style="color: transparent;"
              value="{{teamDialogPassword}}"
              focus="{{teamDialogPasswordFocus}}"
              bindinput="onTeamDialogPasswordInput"
              bindblur="onTeamDialogPasswordBlur"
            />
          </view>
          <view class="field-hint">{{i18n.page.teamPasswordHint}}</view>
        </view>

        <view class="sheet-actions">
          <button class="btn-secondary sheet-btn" bindtap="closeTeamDialog">{{i18n.common.cancel}}</button>
          <button class="btn-primary sheet-btn" bindtap="confirmTeamDialog" loading="{{teamDialogSubmitting}}" disabled="{{teamDialogSubmitting}}">
            {{teamDialogMode === 'join' ? i18n.common.join : i18n.common.create}}
          </button>
        </view>
      </view>
    </view>

    <view class="page-overlay" wx:if="{{nicknamePromptOpen}}">
      <view class="overlay-card nickname-overlay-card" catchtap="noop">
        <view class="overlay-title">{{i18n.page.nicknameSetupTitle}}</view>
        <view class="overlay-text">{{canUseNicknameInput ? i18n.page.nicknameSetupText : i18n.page.nicknameSetupFallbackText}}</view>

        <form bindsubmit="submitProfile">
          <view class="profile-fields">
            <input
              class="input-control"
              name="nickname"
              type="{{canUseNicknameInput ? 'nickname' : 'text'}}"
              maxlength="20"
              placeholder="{{i18n.page.nicknamePlaceholder}}"
              value="{{profileNickname}}"
              bindinput="onProfileNicknameInput"
            />
            <view class="field-hint">{{canUseNicknameInput ? i18n.page.profileOfficialTip : i18n.page.profileFallbackTip}}</view>
            <button class="btn-primary profile-save-btn" form-type="submit" loading="{{savingProfile}}" disabled="{{savingProfile}}">
              {{i18n.page.profileAction}}
            </button>
          </view>
        </form>
      </view>
    </view>

    <view class="card form-card assistant-form-card {{waitingFeedbackActive ? 'assistant-form-card-feedback' : ''}}">
      <view class="assistant-input-row">
        <textarea
          class="textarea-control assistant-textarea assistant-textarea-inline"
          placeholder="{{i18n.page.assistantInputPlaceholder}}"
          value="{{question}}"
          bindinput="onQuestionInput"
          auto-height="false"
          cursor-spacing="20"
        />
        <button class="btn-primary send-btn send-btn-inline {{loading ? 'send-btn-inline-stop' : ''}}" bindtap="askAssistant">{{loading ? i18n.page.stop : i18n.page.send}}</button>
      </view>
    </view>

    <view class="card" wx:if="{{answer || loading}}">
      <view class="section-header answer-header">
        <view class="section-title">{{i18n.page.answerTitle}}</view>
        <view class="answer-tools" wx:if="{{answerStatus === 'awaiting_confirmation'}}">
          <view class="answer-top-chip answer-top-chip-cancel" data-token="cancel" bindtap="onQuickReply">{{i18n.common.cancel}}</view>
          <view class="answer-top-chip answer-top-chip-confirm" data-token="confirm" bindtap="onQuickReply">{{i18n.common.confirm}}</view>
        </view>
        <view class="answer-tools" wx:if="{{answerStatus !== 'awaiting_confirmation' && answerCanUndo}}">
          <view class="answer-top-chip answer-top-chip-undo" bindtap="undoAssistantBatch">{{i18n.common.undo}}</view>
        </view>
      </view>

      <view class="answer-text">{{answer}}</view>
      <view class="answer-status" wx:if="{{answerStatusLabel}}">{{i18n.page.statusLabel}}{{answerStatusLabel}}</view>

      <view class="quick-replies" wx:if="{{answerStatus === 'blocked'}}">
        <view class="quick-reply-btn" data-token="reschedule" bindtap="onQuickReply">{{i18n.page.reschedule}}</view>
        <view class="quick-reply-btn quick-reply-btn-secondary" data-token="force_create" bindtap="onQuickReply">{{i18n.page.createAnyway}}</view>
        <view class="quick-reply-btn quick-reply-btn-secondary" data-token="cancel" bindtap="onQuickReply">{{i18n.common.cancel}}</view>
      </view>

      <view class="quick-replies" wx:if="{{answerStatus === 'collecting' && firstMissingSlot === 'type'}}">
        <view class="quick-reply-btn" data-token="expense" bindtap="onQuickReply">{{i18n.page.expense}}</view>
        <view class="quick-reply-btn quick-reply-btn-secondary" data-token="income" bindtap="onQuickReply">{{i18n.page.income}}</view>
      </view>

      <view class="quick-replies" wx:if="{{answerStatus === 'collecting' && firstMissingSlot === 'category'}}">
        <view class="quick-reply-btn" data-token="food" bindtap="onQuickReply">{{i18n.page.quickFood}}</view>
        <view class="quick-reply-btn quick-reply-btn-secondary" data-token="transport" bindtap="onQuickReply">{{i18n.page.quickTransport}}</view>
        <view class="quick-reply-btn quick-reply-btn-secondary" data-token="shopping" bindtap="onQuickReply">{{i18n.page.quickShopping}}</view>
      </view>

      <view class="muted answer-data" wx:if="{{answerDataText}}">{{answerDataText}}</view>
    </view>

    <view class="card graph-card assistant-graph-card {{!assistantGraphState.highlightedStages.length && !loading && !answer ? 'assistant-graph-card-idle' : ''}} {{assistantGraphPulseActive ? 'assistant-graph-card-pulse' : ''}}">
      <view class="section-header assistant-graph-header">
        <view class="section-title assistant-graph-title">{{graphI18n.graphTitle}}</view>
        <view class="section-meta assistant-graph-meta">{{graphI18n.graphMeta}}</view>
      </view>

      <view class="graph-idle-ambient" wx:if="{{!assistantGraphState.highlightedStages.length && !loading && !answer}}">
        <view class="graph-idle-orb"></view>
        <view class="graph-idle-halo graph-idle-halo-soft"></view>
      </view>
      <view class="graph-pulse-burst" wx:if="{{assistantGraphPulseActive}}">
        <view class="graph-pulse-core"></view>
        <view class="graph-pulse-wave"></view>
      </view>

      <view class="graph-row">
        <view class="{{assistantGraphNodes[0].className}}" data-index="0" bindlongpress="onGraphNodeLongPress">
          <view class="graph-node-title">{{assistantGraphNodes[0].title}}</view>
          <view class="graph-node-desc">{{assistantGraphNodes[0].desc}}</view>
        </view>
        <view class="graph-center graph-center-arrow">
          <view class="graph-arrow-line"></view>
          <view class="graph-arrow-head"></view>
        </view>
        <view class="{{assistantGraphNodes[1].className}}" data-index="1" bindlongpress="onGraphNodeLongPress">
          <view class="graph-node-title">{{assistantGraphNodes[1].title}}</view>
          <view class="graph-node-desc">{{assistantGraphNodes[1].desc}}</view>
        </view>
      </view>

      <view class="graph-row graph-row-connector">
        <view class="graph-spacer"></view>
        <view class="graph-center">
          <view class="graph-stem"></view>
        </view>
        <view class="graph-spacer"></view>
      </view>

      <view class="graph-row">
        <view class="{{assistantGraphNodes[2].className}}" data-index="2" bindlongpress="onGraphNodeLongPress">
          <view class="graph-node-title">{{assistantGraphNodes[2].title}}</view>
          <view class="graph-node-desc">{{assistantGraphNodes[2].desc}}</view>
        </view>
        <view class="graph-center graph-center-fork">
          <view class="graph-fork-horizontal"></view>
          <view class="graph-fork-vertical"></view>
        </view>
        <view class="{{assistantGraphNodes[3].className}}" data-index="3" bindlongpress="onGraphNodeLongPress">
          <view class="graph-node-title">{{assistantGraphNodes[3].title}}</view>
          <view class="graph-node-desc">{{assistantGraphNodes[3].desc}}</view>
        </view>
      </view>

      <view class="graph-row graph-row-connector">
        <view class="graph-spacer"></view>
        <view class="graph-center">
          <view class="graph-stem"></view>
        </view>
        <view class="graph-spacer"></view>
      </view>

      <view class="graph-row">
        <view class="{{assistantGraphNodes[4].className}}" data-index="4" bindlongpress="onGraphNodeLongPress">
          <view class="graph-node-title">{{assistantGraphNodes[4].title}}</view>
          <view class="graph-node-desc">{{assistantGraphNodes[4].desc}}</view>
        </view>
        <view class="graph-center graph-center-arrow">
          <view class="graph-arrow-line"></view>
          <view class="graph-arrow-head"></view>
        </view>
        <view class="{{assistantGraphNodes[5].className}}" data-index="5" bindlongpress="onGraphNodeLongPress">
          <view class="graph-node-title">{{assistantGraphNodes[5].title}}</view>
          <view class="graph-node-desc">{{assistantGraphNodes[5].desc}}</view>
        </view>
      </view>

      <view class="graph-foot">
        <view class="graph-pill">{{graphI18n.graphUndo}}</view>
        <view class="graph-foot-text">{{graphI18n.graphUndoDesc}}</view>
      </view>
    </view>
  </view>
</view>
