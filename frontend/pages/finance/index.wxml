<view class="page-overlay" wx:if="{{teamReady && !hasTeam}}">
  <view class="overlay-card">
    <view class="overlay-title">还没有团队</view>
    <view class="overlay-text">请先到助手页创建或加入团队。</view>
    <button class="btn-primary" bindtap="goAssistantPage">去助手页</button>
  </view>
</view>

<view wx:if="{{hasTeam}}">
  <finance-chart records="{{records}}" />

  <view class="card">
    <view class="section-title">新增费用</view>
    <input class="input-control form-gap" type="digit" placeholder="金额" value="{{form.amount}}" bindinput="onInputAmount" />
    <view class="type-toggle form-gap">
      <view class="type-option type-expense {{form.type === 'expense' ? 'type-option-active' : ''}}" data-type="expense" bindtap="onTypeChange">支出</view>
      <view class="type-option type-income {{form.type === 'income' ? 'type-option-active' : ''}}" data-type="income" bindtap="onTypeChange">收入</view>
    </view>
    <input class="input-control form-gap" placeholder="分类" value="{{form.category}}" bindinput="onInputCategory" />

    <view class="field-label">地点（选填）</view>
    <button class="btn-secondary location-btn" bindtap="chooseLocation">地图选点</button>
    <view class="location-preview" wx:if="{{form.placeName}}">
      <view>{{form.placeName}}</view>
      <view class="muted small-text">GPS：{{form.placeLatitude}}, {{form.placeLongitude}}</view>
      <view class="location-clear" bindtap="clearLocation">清空地点</view>
    </view>

    <input class="input-control" placeholder="备注" value="{{form.note}}" bindinput="onInputNote" />
    <button class="btn-primary" bindtap="createRecord">创建记录</button>
  </view>

  <view class="list-title">费用记录</view>
  <block wx:if="{{records.length}}">
    <block wx:for="{{records}}" wx:key="id">
      <view class="swipe-row">
        <view class="delete-bg" style="width: {{item.deleteWidth}}px;">
          <view class="delete-action" data-index="{{index}}" bindtap="onTapDelete">删除</view>
        </view>
        <view
          class="swipe-content"
          data-index="{{index}}"
          style="transform: translateX({{item.offsetX}}px);"
          catchtouchstart="onSwipeStart"
          catchtouchmove="onSwipeMove"
          catchtouchend="onSwipeEnd"
        >
          <view class="card record-card">
            <view class="record-top">
              <view class="record-category">{{item.category}}</view>
              <view class="record-amount {{item.type}}">{{item.amountText}}</view>
            </view>
            <view class="muted">创建人：{{item.creatorName}}</view>
            <view class="muted">地点：{{item.locationText}}</view>
            <view class="muted">{{item.note || "无备注"}}</view>
            <view class="muted small">{{item.createdText}}</view>
          </view>
        </view>
      </view>
    </block>
  </block>
  <view wx:else class="card muted">暂无费用记录</view>
</view>
