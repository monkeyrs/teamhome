<view class="page-overlay" wx:if="{{teamReady && !hasTeam}}">
  <view class="overlay-card">
    <view class="overlay-title">还没有团队</view>
    <view class="overlay-text">请先到助手页创建或加入团队，再开始记录费用。</view>
    <button class="btn-primary" bindtap="goAssistantPage">去助手页</button>
  </view>
</view>

<view class="page-overlay composer-overlay" wx:if="{{hasTeam && composerOpen}}">
  <view class="overlay-card composer-card">
    <view class="section-header">
      <view class="section-title">{{composerMode === 'edit' ? '修改记录' : '创建记录'}}</view>
      <view class="composer-close" bindtap="closeComposer">收起</view>
    </view>

    <view class="form-card">
      <view class="field-group">
        <view class="field-label">金额</view>
        <input class="input-control" type="digit" placeholder="输入金额" value="{{form.amount}}" bindinput="onInputAmount" />
      </view>

      <view class="field-group">
        <view class="field-label">类型</view>
        <view class="type-toggle">
          <view class="type-option type-expense {{form.type === 'expense' ? 'type-option-active' : ''}}" data-type="expense" bindtap="onTypeChange">支出</view>
          <view class="type-option type-income {{form.type === 'income' ? 'type-option-active' : ''}}" data-type="income" bindtap="onTypeChange">收入</view>
        </view>
      </view>

      <view class="field-group">
        <view class="field-label">分类</view>
        <input class="input-control" placeholder="例如：餐饮、交通、房租" value="{{form.category}}" bindinput="onInputCategory" />
      </view>

      <view class="field-grid">
        <view class="field-group field-half">
          <view class="field-label">地点</view>
          <button class="btn-secondary location-btn" bindtap="chooseLocation">地图选点</button>
          <view class="info-panel location-preview" wx:if="{{form.placeName}}">
            <view class="location-name">{{form.placeName}}</view>
            <view class="muted small-text">GPS：{{form.placeLatitude}}, {{form.placeLongitude}}</view>
            <view class="location-clear" bindtap="clearLocation">清空地点</view>
          </view>
        </view>

        <view class="field-group field-half">
          <view class="field-label">备注</view>
          <input class="input-control" placeholder="选填" value="{{form.note}}" bindinput="onInputNote" />
        </view>
      </view>

      <button class="btn-primary" bindtap="submitRecord">{{composerMode === 'edit' ? '保存修改' : '创建记录'}}</button>
    </view>
  </view>
</view>

<view wx:if="{{hasTeam}}" class="page-shell">
  <view class="page-stack">
    <view class="hero-card">
      <view class="hero-eyebrow">团队账本</view>
      <view class="hero-title">费用</view>
      <view class="hero-desc">用更轻量的表单记录收支，并快速查看支出分类分布。</view>
    </view>

    <finance-chart records="{{records}}" />

    <view class="card create-strip" bindtap="openCreateComposer">
      <view class="create-strip-title">创建记录</view>
      <view class="create-strip-meta">{{composerOpen ? "收起中" : "点击展开"}}</view>
    </view>

    <view class="list-title">全部记录</view>
    <block wx:if="{{records.length}}">
      <block wx:for="{{records}}" wx:key="id">
        <view class="swipe-row">
          <view class="edit-bg" style="width: {{item.editWidth}}px;">
            <view class="edit-action" data-index="{{index}}" bindtap="onTapEdit">修改</view>
          </view>
          <view class="delete-bg" style="width: {{item.deleteWidth}}px;">
            <view class="delete-action" data-index="{{index}}" bindtap="onTapDelete">删除</view>
          </view>
          <view
            class="swipe-content"
            data-index="{{index}}"
            style="transform: translateX({{item.offsetX}}px);"
            bindtouchstart="onSwipeStart"
            bindtouchmove="onSwipeMove"
            bindtouchend="onSwipeEnd"
          >
            <view class="card record-card">
              <view class="record-top">
                <view class="record-category">{{item.category}}</view>
                <view class="record-amount {{item.type}}">{{item.amountText}}</view>
              </view>
              <view class="record-meta">{{item.creatorName}}</view>
              <view class="record-note">{{item.note || "无备注"}}</view>
              <view class="record-foot">
                <view class="record-place">{{item.locationText}}</view>
                <view class="record-time">{{item.createdText}}</view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>
    <view wx:else class="card empty-card">
      <view class="empty-title">暂无费用记录</view>
      <view class="empty-text">创建第一笔收支后，这里会自动更新。</view>
    </view>
  </view>
</view>
