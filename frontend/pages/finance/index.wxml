<view class="page-overlay" wx:if="{{teamReady && !hasTeam}}">
  <view class="overlay-card">
    <view class="overlay-title">{{i18n.page.noTeamTitle}}</view>
    <view class="overlay-text">{{i18n.page.noTeamText}}</view>
    <button class="btn-primary" bindtap="goAssistantPage">{{i18n.page.goAssistant}}</button>
  </view>
</view>

<view class="page-overlay composer-overlay" wx:if="{{hasTeam && composerOpen}}">
  <view class="overlay-card composer-card">
    <view class="section-header">
      <view class="section-title">{{composerMode === 'edit' ? i18n.page.composerEdit : i18n.page.composerCreate}}</view>
    </view>

    <view class="form-card">
      <view class="field-row compact-row">
        <view class="field-group amount-group">
          <view class="field-label">{{i18n.page.amount}}</view>
          <input class="input-control" type="digit" placeholder="{{i18n.page.amountPlaceholder}}" value="{{form.amount}}" bindinput="onInputAmount" />
        </view>
        <view class="field-group type-group">
          <view class="field-label">{{i18n.page.type}}</view>
          <view class="type-toggle small-toggle">
            <view class="type-option {{form.type === 'expense' ? 'type-option-active type-expense' : ''}}" data-type="expense" bindtap="onTypeChange">{{i18n.page.expense}}</view>
            <view class="type-option {{form.type === 'income' ? 'type-option-active type-income' : ''}}" data-type="income" bindtap="onTypeChange">{{i18n.page.income}}</view>
          </view>
        </view>
      </view>

      <view class="field-row compact-row">
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.date}}</view>
          <picker mode="date" value="{{form.occurredDate}}" bindchange="onDateChange">
            <view class="picker">{{form.occurredDate}}</view>
          </picker>
        </view>
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.time}}</view>
          <picker mode="time" value="{{form.occurredTime}}" bindchange="onTimeChange">
            <view class="picker">{{form.occurredTime}}</view>
          </picker>
        </view>
      </view>

      <view class="field-row compact-row category-row">
        <view class="field-group category-input-group">
          <view class="field-label">{{i18n.page.nature || (locale === 'en-US' ? 'Nature' : (locale === 'ja-JP' ? '性質' : '性质'))}}</view>
          <input
            class="input-control"
            placeholder="{{i18n.page.naturePlaceholder || (locale === 'en-US' ? 'Example: Transport, Meals, Lodging' : (locale === 'ja-JP' ? '例：交通・食費・宿泊' : '例如：交通、餐费、住宿'))}}"
            value="{{form.category}}"
            bindinput="onInputCategory"
          />
        </view>
        <view class="field-group category-quick-group" wx:if="{{commonCategories.length >= 1}}">
          <view class="field-label">{{i18n.page.commonCategories}}</view>
          <scroll-view scroll-x class="category-scroll" enhanced show-scrollbar="false">
            <view class="category-chips">
              <block wx:for="{{commonCategories}}" wx:key="*this">
                <view class="category-chip {{form.category === item ? 'category-chip-active' : ''}}" data-category="{{item}}" bindtap="onPickCategory">{{item}}</view>
              </block>
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="field-row compact-row">
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.note}}</view>
          <input class="input-control" placeholder="{{i18n.page.notePlaceholder}}" value="{{form.note}}" bindinput="onInputNote" />
        </view>
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.location}}</view>
          <button class="btn-secondary location-btn" bindtap="chooseLocation">{{i18n.page.locationPick}}</button>
          <view class="info-panel location-preview" wx:if="{{form.placeName}}">
            <view class="location-name">{{form.placeName}}</view>
            <view class="muted small-text">{{i18n.common.gpsPrefix}}: {{form.placeLatitude}}, {{form.placeLongitude}}</view>
            <view class="location-clear" bindtap="clearLocation">{{i18n.page.locationClear}}</view>
          </view>
        </view>
      </view>

      <view class="composer-actions">
        <view class="action-side action-side-left">
          <view wx:if="{{composerMode === 'edit'}}" class="danger-mini-btn" bindtap="confirmDeleteEditingRecord">{{i18n.common.delete}}</view>
        </view>
        <button class="btn-primary composer-submit" bindtap="submitRecord">{{composerMode === 'edit' ? i18n.page.saveEdit : i18n.page.createRecord}}</button>
        <view class="action-side action-side-right">
          <view class="composer-close action-cancel" bindtap="closeComposer">{{i18n.common.cancel}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{hasTeam}}" class="page-shell">
  <view class="page-stack">
    <view class="sticky-stack">
      <view class="card info-card">
        <view class="info-head">
          <view class="info-copy">{{i18n.page.heroInfo}}</view>
          <view class="info-filters">
            <view class="info-filter info-filter-expense {{showExpenseOnly ? 'info-filter-expense-active' : ''}}" bindtap="toggleExpenseFilter">{{i18n.page.expenseOnly}}</view>
            <view class="info-filter info-filter-income {{showIncomeOnly ? 'info-filter-income-active' : ''}}" bindtap="toggleIncomeFilter">{{i18n.page.incomeOnly}}</view>
          </view>
        </view>
      </view>
      <view class="card create-strip" bindtap="openCreateComposer">
        <view class="create-strip-plus">+</view>
      </view>
    </view>

    <view class="record-flow">
      <block wx:if="{{visibleRecords.length}}">
        <block wx:for="{{visibleRecords}}" wx:key="id">
          <view class="swipe-row">
            <view class="edit-bg" style="width: {{item.editWidth}}px;">
              <view class="edit-action" data-index="{{index}}" bindtap="onTapEdit">{{i18n.common.edit}}</view>
            </view>
            <view class="left-action-bg" style="width: {{item.leftActionWidth}}px;">
              <view class="left-action" data-index="{{index}}" bindtap="onTapLeftAction">{{i18n.page.duplicate}}</view>
            </view>
            <view
              class="swipe-content"
              data-index="{{index}}"
              style="transform: translateX({{item.offsetX}}px);"
              bindtouchstart="onSwipeStart"
              bindtouchmove="onSwipeMove"
              bindtouchend="onSwipeEnd"
            >
              <view class="card record-card">
                <view class="record-top">
                  <view class="record-category">{{item.category}}</view>
                  <view class="record-amount {{item.type}}">{{item.amountText}}</view>
                </view>
                <view class="record-grid">
                  <view class="record-cell">
                    <view class="record-label">{{i18n.page.creator}}</view>
                    <view class="record-value">{{item.creatorName}}</view>
                  </view>
                  <view class="record-cell">
                    <view class="record-label">{{i18n.page.type}}</view>
                    <view class="record-value">{{item.type === 'income' ? i18n.page.income : i18n.page.expense}}</view>
                  </view>
                  <view class="record-cell">
                    <view class="record-label">{{i18n.page.occurredAt}}</view>
                    <view class="record-value">{{item.occurredText}}</view>
                  </view>
                  <view class="record-cell">
                    <view class="record-label">{{i18n.page.location}}</view>
                    <view class="record-value">{{item.locationText}}</view>
                  </view>
                  <view class="record-cell record-cell-full">
                    <view class="record-label">{{i18n.page.note}}</view>
                    <view class="record-value">{{item.note || i18n.common.noNote}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="card empty-card">
        <view class="empty-title">{{i18n.page.emptyTitle}}</view>
        <view class="empty-text">{{i18n.page.emptyText}}</view>
      </view>
    </view>
  </view>
</view>
