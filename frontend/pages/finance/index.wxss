.composer-overlay {
  align-items: flex-end;
}

.composer-card {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  max-height: 88vh;
  overflow: auto;
}

.composer-close {
  font-size: 24rpx;
  color: var(--text-link);
}

.danger-mini-btn {
  min-width: 92rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: var(--text-inverse);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-side {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.action-side-left {
  justify-content: flex-start;
}

.action-side-right {
  justify-content: center;
}

.composer-submit {
  min-width: 220rpx;
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--text-inverse);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.action-cancel {
  min-width: 72rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-card {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.sticky-stack {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--bg-page);
  margin: -24rpx -24rpx 0;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.info-copy {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.info-filters {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.info-filter {
  min-width: 124rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-filter-expense {
  background: #fff1f0;
  color: var(--danger);
}

.info-filter-expense-active {
  background: rgba(250, 81, 81, 0.2);
  color: #c53030;
}

.info-filter-income {
  background: #effaf3;
  color: var(--brand);
}

.info-filter-income-active {
  background: rgba(7, 193, 96, 0.2);
  color: #0f8f4c;
}

.record-flow {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.create-strip {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--bg-primary-soft);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.create-strip-plus {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 500;
  color: var(--brand);
}

.field-row {
  display: flex;
  gap: 16rpx;
}

.compact-row {
  align-items: flex-start;
}

.field-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.field-half {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.amount-group {
  flex: 1;
}

.type-group {
  width: 240rpx;
  flex-shrink: 0;
}

.type-toggle {
  display: flex;
  gap: 12rpx;
}

.small-toggle {
  gap: 10rpx;
}

.type-option {
  flex: 1;
  min-height: 72rpx;
  border-radius: var(--radius-control);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--bg-secondary);
  color: var(--text-secondary);
}

.type-option-active.type-expense {
  background: #fff1f0;
  color: var(--danger);
  box-shadow: inset 0 0 0 2rpx rgba(250, 81, 81, 0.24);
}

.type-option-active.type-income {
  background: #effaf3;
  color: var(--brand);
  box-shadow: inset 0 0 0 2rpx rgba(7, 193, 96, 0.24);
}

.category-row {
  align-items: flex-start;
}

.category-input-group {
  flex: 1;
}

.category-quick-group {
  width: 44%;
  flex-shrink: 0;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-chips {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 0;
}

.category-chip {
  flex-shrink: 0;
  min-width: 96rpx;
  padding: 0 24rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-chip-active {
  background: rgba(7, 193, 96, 0.12);
  color: var(--brand);
}

.location-btn {
  justify-content: flex-start;
}

.location-preview {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.location-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.location-clear {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-link);
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.edit-bg,
.left-action-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  overflow: hidden;
}

.edit-bg {
  left: 0;
  background: #fff7e8;
  justify-content: flex-start;
}

.left-action-bg {
  right: 0;
  background: #f0f7ff;
  justify-content: flex-end;
}

.edit-action,
.left-action {
  width: 88px;
  height: 100%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-action {
  color: #b7791f;
}

.left-action {
  color: #2b6cb0;
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.16s ease;
}

.record-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-category {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.record-amount {
  font-size: 34rpx;
  font-weight: 600;
}

.record-amount.expense {
  color: var(--danger);
}

.record-amount.income {
  color: var(--brand);
}

.record-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
}

.record-cell {
  width: calc(50% - 8rpx);
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-cell-full {
  width: 100%;
}

.record-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-value {
  font-size: 26rpx;
  color: var(--text-regular);
  line-height: 1.45;
  word-break: break-word;
}
