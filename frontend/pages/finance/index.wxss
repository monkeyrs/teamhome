.composer-overlay {
  align-items: flex-end;
}

.composer-card {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  max-height: 88vh;
  overflow: auto;
}

.composer-close {
  font-size: 24rpx;
  color: var(--text-link);
}

.create-strip {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.create-strip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.create-strip-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.type-toggle {
  display: flex;
  gap: 12rpx;
}

.field-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.field-half {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.type-option {
  flex: 1;
  min-height: 88rpx;
  border-radius: var(--radius-control);
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.type-expense {
  background: #fff4f4;
  color: var(--danger);
}

.type-income {
  background: var(--bg-primary-soft);
  color: var(--brand);
}

.type-option-active.type-expense {
  box-shadow: inset 0 0 0 2rpx rgba(250, 81, 81, 0.32);
}

.type-option-active.type-income {
  box-shadow: inset 0 0 0 2rpx rgba(7, 193, 96, 0.32);
}

.location-btn {
  justify-content: flex-start;
}

.location-preview {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.location-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.location-clear {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-link);
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.edit-bg,
.delete-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  overflow: hidden;
}

.edit-bg {
  left: 0;
  background: #f0f7ff;
  justify-content: flex-start;
}

.delete-bg {
  right: 0;
  background: var(--danger);
  justify-content: flex-end;
}

.edit-action,
.delete-action {
  width: 88px;
  height: 100%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-action {
  color: #2b6cb0;
}

.delete-action {
  color: var(--text-inverse);
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.16s ease;
}

.record-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.record-top,
.record-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-category {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.record-amount {
  font-size: 34rpx;
  font-weight: 600;
}

.record-amount.expense {
  color: var(--danger);
}

.record-amount.income {
  color: var(--brand);
}

.record-meta,
.record-note,
.record-place,
.record-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-note {
  color: var(--text-regular);
}

.record-place {
  flex: 1;
  min-width: 0;
}

.record-time {
  flex-shrink: 0;
}
