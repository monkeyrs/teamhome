.page-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.overlay-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.overlay-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
}

.overlay-text {
  margin: 16rpx 0 20rpx;
  color: #666666;
}

.form-gap {
  margin-bottom: 12rpx;
}

.field-label {
  margin: 8rpx 0;
  font-size: 24rpx;
  color: #666666;
}

.type-toggle {
  display: flex;
  gap: 16rpx;
}

.type-option {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: 2rpx solid transparent;
}

.type-expense {
  background: #fff1f0;
  color: #fa5151;
}

.type-income {
  background: #e8f7ef;
  color: #07c160;
}

.type-option-active.type-expense {
  border-color: #fa5151;
  box-shadow: 0 0 0 2rpx rgba(250, 81, 81, 0.12);
}

.type-option-active.type-income {
  border-color: #07c160;
  box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.12);
}

.location-btn {
  margin-top: 0;
}

.location-preview {
  margin: 12rpx 0 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}

.location-clear {
  margin-top: 10rpx;
  color: #576b95;
  font-size: 24rpx;
}

.small-text {
  font-size: 22rpx;
}

.swipe-row {
  position: relative;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.delete-bg {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  background: #fa5151;
  display: flex;
  justify-content: flex-end;
  overflow: hidden;
}

.delete-action {
  width: 88px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.16s ease;
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-card {
  margin: 0;
}

.record-category {
  font-size: 32rpx;
  font-weight: 600;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.record-amount.expense {
  color: #fa5151;
}

.record-amount.income {
  color: #07c160;
}

.small {
  font-size: 22rpx;
  margin-top: 8rpx;
}
