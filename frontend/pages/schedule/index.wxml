<view class="page-overlay" wx:if="{{teamReady && !hasTeam}}">
  <view class="overlay-card">
    <view class="overlay-title">{{i18n.page.noTeamTitle}}</view>
    <view class="overlay-text">{{i18n.page.noTeamText}}</view>
    <button class="btn-primary" bindtap="goAssistantPage">{{i18n.page.goAssistant}}</button>
  </view>
</view>

<view class="page-overlay composer-overlay" wx:if="{{hasTeam && composerOpen}}">
  <view class="overlay-card composer-card">
    <view class="section-header">
      <view class="section-title">{{composerMode === 'edit' ? i18n.page.composerEdit : i18n.page.composerCreate}}</view>
    </view>

    <view class="form-card">
      <view class="field-group">
        <view class="field-label">{{i18n.page.titleLabel}}</view>
        <input class="input-control" placeholder="{{i18n.page.titlePlaceholder}}" value="{{form.title}}" bindinput="onInputTitle" />
      </view>

      <view class="field-grid">
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.descriptionLabel}}</view>
          <input class="input-control" placeholder="{{i18n.page.descriptionPlaceholder}}" value="{{form.description}}" bindinput="onInputDescription" />
        </view>

        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.locationLabel}}</view>
          <button class="btn-secondary location-btn" bindtap="chooseLocation">{{i18n.page.locationPick}}</button>
          <view class="info-panel location-preview" wx:if="{{form.placeName}}">
            <view class="location-name">{{form.placeName}}</view>
            <view class="muted small-text">{{i18n.common.gpsPrefix}}: {{form.placeLatitude}}, {{form.placeLongitude}}</view>
            <view class="location-clear" bindtap="clearLocation">{{i18n.page.locationClear}}</view>
          </view>
        </view>
      </view>

      <view class="switch-row">
        <view>
          <view class="switch-title">{{i18n.page.allDayTitle}}</view>
          <view class="field-hint">{{i18n.page.allDayHint}}</view>
        </view>
        <checkbox-group bindchange="onToggleAllDay">
          <label class="checkbox-line">
            <checkbox value="allDay" checked="{{form.is_all_day}}" color="#07c160" />
          </label>
        </checkbox-group>
      </view>

      <view class="field-grid">
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.startDate}}</view>
          <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
            <view class="picker {{form.date ? '' : 'placeholder'}}">{{form.date || i18n.page.selectDate}}</view>
          </picker>
        </view>

        <view class="field-group field-half" wx:if="{{!form.is_all_day}}">
          <view class="field-label">{{i18n.page.startTime}}</view>
          <picker mode="time" value="{{form.start_clock}}" bindchange="onTimeChange">
            <view class="picker">{{form.start_clock}}</view>
          </picker>
        </view>
      </view>

      <view class="field-grid">
        <view class="field-group field-half">
          <view class="field-label">{{i18n.page.endDate}}</view>
          <picker mode="date" value="{{form.end_date}}" bindchange="onEndDateChange">
            <view class="picker {{form.end_date ? '' : 'placeholder'}}">{{form.end_date || i18n.page.selectDate}}</view>
          </picker>
        </view>

        <view class="field-group field-half" wx:if="{{!form.is_all_day}}">
          <view class="field-label">{{i18n.page.endTime}}</view>
          <picker mode="time" value="{{form.end_clock}}" bindchange="onEndTimeChange">
            <view class="picker">{{form.end_clock}}</view>
          </picker>
        </view>
      </view>

      <view class="composer-actions">
        <view class="action-side action-side-left">
          <view wx:if="{{composerMode === 'edit'}}" class="danger-mini-btn" bindtap="confirmDeleteEditingSchedule">{{i18n.common.delete}}</view>
        </view>
        <button class="btn-primary composer-submit" bindtap="submitSchedule">{{composerMode === 'edit' ? i18n.page.saveEdit : i18n.page.createRecord}}</button>
        <view class="action-side action-side-right">
          <view class="composer-close action-cancel" bindtap="closeComposer">{{i18n.common.cancel}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{hasTeam}}" class="page-shell">
  <view class="page-stack">
    <view class="sticky-stack">
      <view class="card info-card">
        <view class="info-head">
          <view class="info-copy">{{i18n.page.heroInfo}}</view>
          <view class="info-filter {{showPendingOnly ? 'info-filter-active' : ''}}" bindtap="togglePendingFilter">{{i18n.page.pendingOnly}}</view>
        </view>
      </view>
      <view class="card create-strip" bindtap="openCreateComposer">
        <view class="create-strip-plus">+</view>
      </view>
    </view>

    <view class="record-flow">
      <block wx:if="{{visibleSchedules.length}}">
        <block wx:for="{{visibleSchedules}}" wx:key="id">
          <view class="swipe-row">
            <view class="edit-bg" style="width: {{item.editWidth}}px;">
              <view class="edit-action" data-index="{{index}}" bindtap="onTapEdit">{{i18n.common.edit}}</view>
            </view>
            <view class="left-action-bg {{item.leftActionClass}}" style="width: {{item.leftActionWidth}}px;">
              <view class="left-action {{item.leftActionClass}}" data-index="{{index}}" bindtap="onTapLeftAction">{{item.leftActionText}}</view>
            </view>
            <view
              id="schedule-{{item.id}}"
              class="swipe-content"
              data-index="{{index}}"
              style="transform: translateX({{item.offsetX}}px);"
              bindtouchstart="onSwipeStart"
              bindtouchmove="onSwipeMove"
              bindtouchend="onSwipeEnd"
            >
              <view class="card schedule-card">
                <view class="schedule-head">
                  <view class="title">{{item.title || i18n.page.unnamed}}</view>
                  <view class="status status-{{item.status || 'pending'}}">{{item.statusText}}</view>
                </view>
                <view class="detail-grid">
                  <view class="detail-cell">
                    <view class="detail-label">{{i18n.page.creator}}</view>
                    <view class="detail-value">{{item.creatorName}}</view>
                  </view>
                  <view class="detail-cell">
                    <view class="detail-label">{{i18n.page.place}}</view>
                    <view class="detail-value">{{item.locationText}}</view>
                  </view>
                  <view class="detail-cell">
                    <view class="detail-label">{{i18n.page.start}}</view>
                    <view class="detail-value">{{item.startText}}</view>
                  </view>
                  <view class="detail-cell">
                    <view class="detail-label">{{i18n.page.end}}</view>
                    <view class="detail-value">{{item.endText}}</view>
                  </view>
                  <view class="detail-cell detail-cell-full">
                    <view class="detail-label">{{i18n.page.note}}</view>
                    <view class="detail-value">{{item.noteText}}</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
      <view wx:else class="card empty-card">
        <view class="empty-title">{{i18n.page.emptyTitle}}</view>
        <view class="empty-text">{{i18n.page.emptyText}}</view>
      </view>
      <view wx:if="{{loadingMoreFuture}}" class="future-loading">{{i18n.page.futureLoading}}</view>
    </view>
  </view>
</view>
