.composer-overlay {
  align-items: flex-end;
}

.composer-card {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  max-height: 88vh;
  overflow: auto;
}

.composer-close {
  font-size: 24rpx;
  color: var(--text-link);
}

.danger-mini-btn {
  min-width: 92rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: var(--text-inverse);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.composer-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-side {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.action-side-left {
  justify-content: flex-start;
}

.action-side-right {
  justify-content: center;
}

.composer-submit {
  min-width: 220rpx;
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: var(--text-inverse);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.action-cancel {
  min-width: 72rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info-card {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.sticky-stack {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: var(--bg-page);
  margin: -24rpx -24rpx 0;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.info-copy {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.info-filter {
  min-width: 136rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f0f7ff;
  color: #2b6cb0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info-filter-active {
  background: rgba(43, 108, 176, 0.14);
  color: #1f5f99;
}

.record-flow {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.future-loading {
  padding: 8rpx 0 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

.create-strip {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--bg-primary-soft);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.create-strip-plus {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 500;
  color: var(--brand);
}

.field-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.field-half {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.location-btn {
  justify-content: flex-start;
}

.location-preview {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.location-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.location-clear {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-link);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
}

.switch-title {
  font-size: 30rpx;
  color: var(--text-regular);
}

.checkbox-line {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.edit-bg,
.left-action-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  overflow: hidden;
}

.edit-bg {
  left: 0;
  background: #fff7e8;
  justify-content: flex-start;
}

.left-action-bg {
  right: 0;
  justify-content: flex-end;
}

.left-action-bg.left-action-complete {
  background: #effaf3;
}

.left-action-bg.left-action-pending {
  background: #f0f7ff;
}

.edit-action,
.left-action {
  width: 88px;
  height: 100%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-action {
  color: #b7791f;
}

.left-action {
  color: var(--text-regular);
}

.left-action.left-action-complete {
  color: var(--brand);
}

.left-action.left-action-pending {
  color: #2b6cb0;
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.16s ease;
}

.schedule-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.schedule-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 16rpx;
}

.detail-cell {
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.detail-cell-full {
  width: 100%;
}

.detail-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.detail-value {
  font-size: 26rpx;
  color: var(--text-regular);
  word-break: break-word;
  line-height: 1.45;
}

.status {
  flex-shrink: 0;
  min-width: 116rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-muted);
  color: var(--text-secondary);
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.status-completed {
  background: var(--bg-muted);
  color: var(--text-secondary);
}

.status-pending {
  background: #f0f7ff;
  color: #2b6cb0;
}

.status-cancelled {
  background: var(--bg-warn-soft);
  color: var(--danger);
}
