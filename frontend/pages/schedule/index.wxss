.page-overlay {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.overlay-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.overlay-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
}

.overlay-text {
  margin: 16rpx 0 20rpx;
  color: #666666;
}

.form-gap {
  margin-bottom: 12rpx;
}

.field-label {
  margin: 8rpx 0;
  font-size: 24rpx;
  color: #666666;
}

.location-btn {
  margin-top: 0;
}

.location-preview {
  margin: 12rpx 0 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
}

.location-clear {
  margin-top: 10rpx;
  color: #576b95;
  font-size: 24rpx;
}

.small-text {
  font-size: 22rpx;
}

.checkbox-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0;
  color: #353535;
}

.swipe-row {
  position: relative;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.delete-bg {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  background: #fa5151;
  display: flex;
  justify-content: flex-end;
  overflow: hidden;
}

.delete-action {
  width: 88px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.16s ease;
}

.schedule-card {
  margin: 0;
  border-left: 8rpx solid #07c160;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: #353535;
}

.row {
  font-size: 24rpx;
  margin: 4rpx 0;
}

.status {
  margin-top: 14rpx;
  font-size: 22rpx;
  display: inline-block;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  background: #f2f2f2;
  color: #666666;
}

.status-completed {
  background: #e8f7ef;
  color: #07c160;
}

.status-cancelled {
  background: #feeeee;
  color: #fa5151;
}
