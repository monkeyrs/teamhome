.composer-overlay {
  align-items: flex-end;
}

.composer-card {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  max-height: 88vh;
  overflow: auto;
}

.composer-close {
  font-size: 24rpx;
  color: var(--text-link);
}

.create-strip {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.create-strip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.create-strip-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.field-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.field-half {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.location-btn {
  justify-content: flex-start;
}

.location-preview {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.location-name {
  font-size: 30rpx;
  color: var(--text-primary);
}

.location-clear {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-link);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
}

.switch-title {
  font-size: 30rpx;
  color: var(--text-regular);
}

.checkbox-line {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.edit-bg,
.delete-bg {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  overflow: hidden;
}

.edit-bg {
  left: 0;
  background: #f0f7ff;
  justify-content: flex-start;
}

.delete-bg {
  right: 0;
  background: var(--danger);
  justify-content: flex-end;
}

.edit-action,
.delete-action {
  width: 88px;
  height: 100%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-action {
  color: #2b6cb0;
}

.delete-action {
  color: var(--text-inverse);
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.16s ease;
}

.schedule-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.schedule-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text-primary);
}

.detail-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-label {
  width: 88rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.detail-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-regular);
  word-break: break-word;
}

.status {
  flex-shrink: 0;
  min-width: 116rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-muted);
  color: var(--text-secondary);
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.status-completed {
  background: var(--bg-primary-soft);
  color: var(--brand);
}

.status-cancelled {
  background: var(--bg-warn-soft);
  color: var(--danger);
}
