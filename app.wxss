page {
  --bg-page: #f7f7f7;
  --bg-card: #ffffff;
  --bg-muted: #f5f5f5;
  --bg-soft: #fafafa;
  --bg-primary-soft: #eaf8f0;
  --bg-warn-soft: #feeeee;
  --text-primary: #191919;
  --text-regular: #353535;
  --text-secondary: #7a7a7a;
  --text-placeholder: #b2b2b2;
  --text-link: #576b95;
  --text-inverse: #ffffff;
  --line-primary: rgba(0, 0, 0, 0.08);
  --line-secondary: rgba(0, 0, 0, 0.04);
  --brand: #07c160;
  --danger: #fa5151;
  --radius-card: 24rpx;
  --radius-control: 16rpx;
  --radius-pill: 999rpx;
  /* Nintendo-style motion tokens */
  --easing-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --easing-spring: cubic-bezier(0.22, 1.2, 0.36, 1);
  --easing-pop: cubic-bezier(0.18, 0.89, 0.32, 1.28);
  --easing-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --duration-fast: 120ms;
  --duration-normal: 240ms;
  --duration-slow: 420ms;
  --color-success: #07c160;
  --color-success-soft: #eaf8f0;
  background: var(--bg-page);
  color: var(--text-regular);
  font-size: 30rpx;
  line-height: 1.5;
  font-family:
    -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero-card,
.card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.hero-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.hero-eyebrow {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.hero-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 600;
  color: var(--text-primary);
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.list-title {
  padding: 8rpx 8rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.form-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.field-hint {
  font-size: 22rpx;
  color: var(--text-placeholder);
}

.input-control,
.textarea-control,
.picker,
.surface-button {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-control);
  background: var(--bg-soft);
  color: var(--text-regular);
  box-sizing: border-box;
}

.input-control,
.picker,
.surface-button {
  line-height: 88rpx;
}

.textarea-control {
  min-height: 192rpx;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.picker.placeholder,
.placeholder {
  color: var(--text-placeholder);
}

.btn-primary,
.btn-secondary,
.mini-action {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-control);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--brand);
  color: var(--text-inverse);
}

.btn-secondary {
  background: var(--bg-soft);
  color: var(--text-regular);
}

.mini-action {
  background: var(--brand);
  color: var(--text-inverse);
  min-width: 192rpx;
}

.muted {
  color: var(--text-secondary);
}

.small-text,
.small {
  font-size: 24rpx;
}

.link-text {
  color: var(--text-link);
}

.info-panel {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--bg-soft);
}

.page-overlay {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.overlay-card {
  width: 100%;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
}

.overlay-title {
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--text-primary);
}

.overlay-text {
  margin: 12rpx 0 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.empty-card {
  text-align: center;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ── Nintendo-style: Button press feedback ── */
.btn-primary:active,
.mini-action:active {
  transform: scale(0.94);
  transition: transform var(--duration-fast) var(--easing-bounce);
}

.btn-secondary:active,
.surface-button:active,
.input-control:active {
  transform: scale(0.98);
  transition: transform var(--duration-fast) var(--easing-soft);
}

/* ── Nintendo-style: Global animation library ── */

/* Elastic bounce — for pop-in elements */
@keyframes nintendo-bounce-in {
  0% {
    opacity: 0;
    transform: scale(0.6);
  }
  50% {
    opacity: 1;
    transform: scale(1.08);
  }
  100% {
    transform: scale(1);
  }
}

/* Spring overshoot — for cards/panels sliding up */
@keyframes nintendo-spring-up {
  0% {
    opacity: 0;
    transform: translateY(40rpx) scale(0.96);
  }
  60% {
    opacity: 1;
    transform: translateY(-6rpx) scale(1.01);
  }
  100% {
    transform: translateY(0) scale(1);
  }
}

/* Pop-in with fade — for answer cards, success pills */
@keyframes nintendo-pop-fade {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.92);
  }
  70% {
    opacity: 1;
    transform: translateY(-4rpx) scale(1.03);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Success ripple — radial expand for create/save confirmations */
@keyframes nintendo-success-ripple {
  0% {
    opacity: 0;
    transform: scale(0.3);
  }
  40% {
    opacity: 0.6;
  }
  100% {
    opacity: 0;
    transform: scale(2.5);
  }
}

/* Shimmer sweep — subtle light sweep for emphasis */
@keyframes nintendo-shimmer {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(200%);
  }
}

/* Float breathe — gentle floating for empty states */
@keyframes nintendo-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

/* Pulse glow — for active states */
@keyframes nintendo-pulse-glow {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(7, 193, 96, 0.2);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(7, 193, 96, 0);
  }
}

/* Processing dots — bouncing dots for loading */
@keyframes nintendo-dot-bounce {
  0%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-10rpx);
  }
}

/* Bar grow — for chart bars growing from 0 */
@keyframes nintendo-bar-grow {
  0% {
    transform: scaleX(0);
    transform-origin: left center;
  }
  60% {
    transform: scaleX(1.02);
    transform-origin: left center;
  }
  100% {
    transform: scaleX(1);
    transform-origin: left center;
  }
}

/* Column grow — for vertical charts growing from bottom */
@keyframes nintendo-column-grow {
  0% {
    transform: scaleY(0);
    transform-origin: bottom center;
  }
  60% {
    transform: scaleY(1.04);
    transform-origin: bottom center;
  }
  100% {
    transform: scaleY(1);
    transform-origin: bottom center;
  }
}

/* Hint shimmy — subtle side-to-side for discoverability hints */
@keyframes nintendo-hint-shimmy {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-6rpx);
  }
  75% {
    transform: translateX(6rpx);
  }
}

/* Stagger entrance helper — use with inline style animation-delay */
.nintendo-stagger {
  opacity: 0;
  animation: nintendo-pop-fade var(--duration-slow) var(--easing-spring) forwards;
}

/* FAB rotation for plus/close toggle */
@keyframes nintendo-fab-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(135deg);
  }
}
